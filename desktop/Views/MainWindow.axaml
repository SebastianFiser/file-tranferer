<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.png"
        Title="desktop">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <StackPanel IsVisible="{Binding IsIdleVisible}" Spacing="12" Width="420">
            <TextBlock Text="{Binding StatusText}" FontSize="24"
                HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasReceived}" HorizontalAlignment="Center" /> 
            <ListBox ItemsSource="{Binding ReceivedFiles}" IsVisible="{Binding HasReceived}" MaxHeight="220" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsTransferVisible}" Spacing="16" Width="360">
            <TextBlock Text="{Binding TransferText}" TextWrapping="Wrap" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding TransferProgress}" />
            <Button Content="Cancel" Command="{Binding CancelTransferCommand}"
                HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsOfferVisible}" Spacing="16">
            <TextBlock Text="{Binding OfferText}" FontSize="20" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Content="Accept" Command="{Binding AcceptCommand}" />
                <Button Content="Reject" Command="{Binding RejectCommand}" />

            </StackPanel>
        </StackPanel>

    </StackPanel>

</Window>
